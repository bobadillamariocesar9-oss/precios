package com.apiprecios.config;

import com.apiprecios.AbstractIntegrationTest;
import com.apiprecios.exception.BadRequestException;
import com.apiprecios.exception.ResourceNotFoundException;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.MediaType;
import org.springframework.test.context.bean.override.mockito.MockitoBean;
import org.springframework.test.web.servlet.MockMvc;
import com.apiprecios.service.UserService;

import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
import static org.mockito.Mockito.*;

/**
 * Tests de integración para GlobalExceptionHandler.
 * Se invocan endpoints reales y se verifica que las excepciones
 * se mapeen correctamente a respuestas ProblemDetail (RFC 9457).
 */
@DisplayName("GlobalExceptionHandler")
class GlobalExceptionHandlerTest extends AbstractIntegrationTest {

    @Autowired
    private MockMvc mockMvc;

    @MockitoBean
    private UserService userService;

    // ─── 404 ResourceNotFoundException ───────────────────────────────────────

    @Test
    @DisplayName("404: ResourceNotFoundException → ProblemDetail con status 404")
    void resourceNotFound_returns404ProblemDetail() throws Exception {
        when(userService.findById(999))
                .thenThrow(new ResourceNotFoundException("User", 999));

        mockMvc.perform(get("/api/users/999"))
                .andExpect(status().isNotFound())
                .andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_PROBLEM_JSON))
                .andExpect(jsonPath("$.status").value(404))
                .andExpect(jsonPath("$.title").value("Recurso no encontrado"))
                .andExpect(jsonPath("$.detail").value("User con id 999 no encontrado"))
                .andExpect(jsonPath("$.timestamp").exists());
    }

    // ─── 400 BadRequestException ──────────────────────────────────────────────

    @Test
    @DisplayName("400: BadRequestException → ProblemDetail con status 400")
    void badRequest_returns400ProblemDetail() throws Exception {
        when(userService.create(any()))
                .thenThrow(new BadRequestException("El email 'x@x.com' ya está registrado"));

        mockMvc.perform(post("/api/users")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("""
                                {
                                  "username": "test",
                                  "email": "x@x.com",
                                  "password": "pass"
                                }
                                """))
                .andExpect(status().isBadRequest())
                .andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_PROBLEM_JSON))
                .andExpect(jsonPath("$.status").value(400))
                .andExpect(jsonPath("$.title").value("Petición inválida"))
                .andExpect(jsonPath("$.detail").value("El email 'x@x.com' ya está registrado"))
                .andExpect(jsonPath("$.timestamp").exists());
    }

    // ─── 400 Validation (@Valid) ──────────────────────────────────────────────

    @Test
    @DisplayName("400: cuerpo inválido → ProblemDetail con campo 'fields'")
    void validationError_returns400WithFields() throws Exception {
        // username y email en blanco disparan @NotBlank y @Email
        mockMvc.perform(post("/api/users")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("""
                                {
                                  "username": "",
                                  "email": "no-es-un-email",
                                  "password": ""
                                }
                                """))
                .andExpect(status().isBadRequest())
                .andExpect(jsonPath("$.status").value(400))
                .andExpect(jsonPath("$.title").value("Error de validación"))
                .andExpect(jsonPath("$.fields").isMap())
                .andExpect(jsonPath("$.timestamp").exists());
    }
}
